# Docker Compose loads .env. Direct Go commands use process environment variables.
APP_ADDR=127.0.0.1:8080
APP_DATA_SOURCE=demo
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=campus
MYSQL_PASSWORD=
MYSQL_DATABASE=campus_events_dev
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
SEED_PASSWORD=replace-with-a-demo-password
# Optional in direct Go mode. Compose uses its internal redis service.
REDIS_ADDR=
REDIS_PASSWORD=
